# Copy to .env.ai.local (ignored by git). No connection starts automatically.
AI_FRAME_PORT=8790
AI_CAMERA_ID=yoosee-onvif2
AI_RTSP_URL=rtsp://192.168.1.5:554/onvif2
AI_CAMERA_USERNAME=
AI_CAMERA_PASSWORD=
AI_RTSP_TRANSPORT=udp
# Optional absolute executable path if ffmpeg is not in PATH.
AI_FFMPEG_PATH=ffmpeg
AI_FRAME_FPS=1
AI_FRAME_WIDTH=640
AI_FRAME_HEIGHT=720
AI_FRAME_STALE_MS=15000
AI_CONNECT_TIMEOUT_MS=25000
AI_PROCESS_TIMEOUT_MS=5000
# Python executable (or py launcher); model path is relative to project root.
AI_PYTHON_PATH=py
AI_MODEL_PATH=models/best.pt
AI_CONFIDENCE=0.5
# Model loading/warmup is separate from the per-frame inference timeout.
AI_MODEL_LOAD_TIMEOUT_MS=120000
# Alerts: emit immediately, then at most one per camera/class per cooldown.
AI_ALERT_COOLDOWN_MS=30000
# Bounded in-memory history; cleared when the backend process restarts.
AI_ALERT_CAPACITY=100
